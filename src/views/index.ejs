  <!-- PROJECT STRUCTURE (folder tree) -->
  <section id="structure" class="py-5">
    <div class="container">
      <div class="row align-items-start">
        <div class="col-lg-6">
          <span class="badge-soft"><i class="bi bi-folder-symlink-fill me-1"></i> structure</span>
          <h2 class="display-6 fw-semibold mt-2 mb-3">ساختار پروژه <span class="text-accent">· project structure</span></h2>
          <p class="text-secondary">معماری تمیز و لایه‌بندی شده بر اساس <strong>Controller-Service</strong> با پشتیبانی از Redis و مدل‌های Mongoose.</p>
          <div class="folder-structure mt-4">
            <pre>
<span class="keyword">├──</span> src/
<span class="keyword">│   ├──</span> config/          <span class="comment"># اتصال MongoDB و Redis</span>
<span class="keyword">│   ├──</span> models/          <span class="comment"># User.js (Mongoose schema)</span>
<span class="keyword">│   ├──</span> services/        <span class="comment"># منطق تجاری، تعامل با دیتابیس</span>
<span class="keyword">│   ├──</span> controllers/     <span class="comment"># مدیریت درخواست‌ها</span>
<span class="keyword">│   ├──</span> middleware/      <span class="comment"># auth, rbac, validation</span>
<span class="keyword">│   ├──</span> routes/          <span class="comment"># تعریف مسیرهای API</span>
<span class="keyword">│   ├──</span> utils/           <span class="comment"># توابع کمکی، ثابت‌ها</span>
<span class="keyword">│   └──</span> app.js           <span class="comment"># نقطه ورود اصلی</span>
            </pre>
          </div>
        </div>
        <div class="col-lg-6 mt-5 mt-lg-0">
